	"dependencies": {
		"@material/material-color-utilities": "npm:@ktibow/material-color-utilities-nightly@latest",
		"disk-color-picker": "^0.2.3",
		"lit": "^3.3.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@rspack/cli": "^2.1.8",
		"@rspack/core": "^2.1.8",
		"@types/node": "^26.1.2",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
