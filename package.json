		"lint-staged": "^17.3.0",
		"minify-html-literals-loader": "^1.1.1",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"ts-loader": "^9.6.2",
		"typescript": "latest",
		"typescript-eslint": "^8.66.0",
		"typescript-plugin-css-modules": "^5.2.0"
